# Copy to `.env` and fill in. This template holds NO secrets and is committed;
# `.env` itself is gitignored. Values shown are placeholders / safe defaults.

# ------------------------------------------------------------
# DATABASE (PostgreSQL)
# ------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/ori_studio?schema=public"

# ------------------------------------------------------------
# FIRST ADMIN (used only by `npm run db:seed`)
# ------------------------------------------------------------
# Public registration always creates a plain "user", so the first admin comes
# from the seed. Password must be 8+ chars with an uppercase letter and a number.
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="ChangeMe123"
ADMIN_NAME="Admin"

# Public base URL of the site, e.g. https://oristudio.co (no trailing slash).
# Used to build absolute links in emails and canonical/sitemap URLs.
APP_URL="http://localhost:3000"

# ------------------------------------------------------------
# AUTH (JWT session cookie)
# ------------------------------------------------------------
# Long random string — sign the session token. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="7ba5838cdb63318a87bf4ce3ef0170cb471a75572ccef5af599d16f23e5fd75c"
# Token lifetime. Default is 7 days if unset.
JWT_EXPIRES_IN="7d"
# "true" marks the session cookie Secure (HTTPS only). Set to true in production
# behind HTTPS; leave blank for local http.
USE_HTTPS=""

# ------------------------------------------------------------
# FILE STORAGE (uploads live OUTSIDE the app tree — see storage-fs.ts)
# ------------------------------------------------------------
# COMMITTED dirs are what gets served; TMP dirs are staging + trash, never
# served. Each TMP must be on the SAME filesystem as its committed pair so
# promote/trash is a cheap atomic rename.
#
# Leave ALL of these blank in development: the code falls back to project-local
# `.data/*` (gitignored). Set them to absolute paths in production, e.g.:
#
#   UPLOADS_DIR="/var/www/ori-uploads"
#   UPLOADS_TMP_DIR="/var/www/ori-uploads-tmp"
#   PRIVATE_UPLOADS_DIR="/var/lib/ori-studio/private"
#   PRIVATE_TMP_DIR="/var/lib/ori-studio/tmp"
UPLOADS_DIR=""
UPLOADS_TMP_DIR=""
PRIVATE_UPLOADS_DIR=""
PRIVATE_TMP_DIR=""
# Hours an unreferenced tmp file survives before `npm run sweep` deletes it.
# Default 24 if unset. Must exceed the longest realistic upload→submit gap.
UPLOADS_TTL_HOURS="24"

# ------------------------------------------------------------
# EMAIL (Nodemailer / SMTP)
# ------------------------------------------------------------
# Used by src/lib/mailer.ts to notify the studio + acknowledge the customer on
# every contact submission. Leave blank to disable sending (submissions still
# save; the mailer just logs a "SMTP not configured" warning).
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
# "true" forces implicit TLS. Optional — port 465 is treated as secure automatically.
SMTP_SECURE=""
# From header, e.g. "ORI Studio <studio@yourdomain.com>". Falls back to SMTP_USER.
MAIL_FROM=""
# Studio inbox that receives new-submission notifications. Falls back to SMTP_USER.
MAIL_TO=""
